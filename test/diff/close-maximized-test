#!/bin/sh

. libtest.sh
. libgit.sh

export LINES=12

steps '
	<Enter>
	:maximize
	:view-close
	:save-display restored-split.screen
	:view-close
	:save-display closed.screen

	<Enter>
	:view-log
	:save-display log.screen
	:view-close
	:save-display restored-after-log.screen
'

tigrc <<EOF
set line-graphics = utf-8
set vertical-split = horizontal
EOF

in_work_dir create_repo_from_tgz "$base_dir/files/scala-js-benchmarks.tgz"

test_tig -n 3

assert_equals 'restored-split.screen' <<EOF
