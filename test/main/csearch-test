#!/bin/sh
#
# Test marking the commits whose contents match a pattern.

. libtest.sh
. libgit.sh

export LINES=12

tigrc <<EOF
set line-graphics = ascii
set main-view = id:no date:no author:no commit-title:yes,graph,refs,overflow=no
set diff-view = line-number:no text
set refresh-mode = after-command
EOF

steps '
	&needle<Enter>
	:save-display csearch-main.screen

	:find-next
	:save-display csearch-first.screen
	:find-next
	:save-display csearch-second.screen

	<Enter>
	:find-next
	:save-display csearch-diff.screen
	:view-close

	:set search-content-paths = no
	:save-display csearch-no-paths.screen
	:set search-content-paths = yes
	:save-display csearch-paths-again.screen

	:exec @git commit --allow-empty -m "Late commit about a needle"
	:save-display csearch-refreshed.screen

	&<Enter>
	:save-display csearch-cleared.screen
'

setup_csearch_repo()
{
	git_init .

	git_add a "hay"
	git_commit -m "Plain commit"

	# Neither its patch nor its message carries the pattern: only the name
	# of the file it edits does.
	git_add needle.txt "hay"
	git_commit -m "Commit adding a file"

	git_add b "a needle in the hay"
	git_commit -m "Patched commit"

	git_add c "hay"
	git_commit -m "Commit about a needle"

	git_add d "hay"
	git_commit -m "Another plain commit"
}

in_work_dir setup_csearch_repo

# The commit made from inside Tig must land on a date of its own.
export GIT_AUTHOR_DATE="$(expr "$author_date" + "$author_date_delta")"
export GIT_COMMITTER_DATE="$GIT_AUTHOR_DATE"

test_tig

# The commit whose patch carries the pattern, the one whose message does and
# the one which only edits a file whose name does are all marked.
assert_equals 'csearch-main.screen' <<EOF
* [master] Another plain commit
* [match] Commit about a needle
* [match] Patched commit
* [match] Commit adding a file
I Plain commit
 
 
 
 
 
[main] 7a88e75e1f65654cfe8db25b5e9146c985d75e1e - commit 1 of 5             100%
EOF

# n steps from one marked commit to the next.
assert_equals 'csearch-first.screen' <<EOF
* [master] Another plain commit
* [match] Commit about a needle
* [match] Patched commit
* [match] Commit adding a file
I Plain commit
 
 
 
 
 
[main] e7c459973e27ad5a0d7a116d37bdd3fbc37044f4 - commit 2 of 5             100%
EOF


assert_equals 'csearch-second.screen' <<EOF
* [master] Another plain commit
* [match] Commit about a needle
* [match] Patched commit
* [match] Commit adding a file
I Plain commit
 
 
 
 
 
[main] 3cc5be064176584c94d3bb5adf2e25e3b3e696eb - commit 3 of 5             100%
EOF

# The pattern doubles as the view search: n goes on to the match itself.
assert_equals 'csearch-diff.screen' <<EOF
* [master] Another plain commit         |new file mode 100644
* [match] Commit about a needle         |index 0000000..7a2788a
* [match] Patched commit                |--- /dev/null
* [match] Commit adding a file          |+++ b/b
I Plain commit                          |@@ -0,0 +1 @@
                                        |+a needle in the hay
                                        |\ No newline at end of file
                                        |
                                        |
                                        |
[main] 3cc5be064176584c94d3bb5adf2e 100%|[diff] Changes to 'b' - line 18 of 100%
EOF

# The option drops the names of the edited files from the search, and
# with them the commits which only matched that way.
assert_equals 'csearch-no-paths.screen' <<EOF
* [master] Another plain commit
* [match] Commit about a needle
* [match] Patched commit
* Commit adding a file
I Plain commit
 
 
 
 
 
[main] 3cc5be064176584c94d3bb5adf2e25e3b3e696eb - commit 3 of 5             100%
EOF

assert_equals 'csearch-paths-again.screen' <<EOF
* [master] Another plain commit
* [match] Commit about a needle
* [match] Patched commit
* [match] Commit adding a file
I Plain commit
 
 
 
 
 
[main] 3cc5be064176584c94d3bb5adf2e25e3b3e696eb - commit 3 of 5             100%
EOF

# A refresh looks again, marking what has turned up since and keeping
# what was already found.
assert_equals 'csearch-refreshed.screen' <<EOF
* [master] [match] Late commit about a needle
* Another plain commit
* [match] Commit about a needle
* [match] Patched commit
* [match] Commit adding a file
I Plain commit
 
 
 
 
[main] e7c459973e27ad5a0d7a116d37bdd3fbc37044f4 - commit 3 of 6             100%
EOF

# An empty pattern drops the markers.
assert_equals 'csearch-cleared.screen' <<EOF
* [master] Late commit about a needle
* Another plain commit
* Commit about a needle
* Patched commit
* Commit adding a file
I Plain commit
 
 
 
 
[main] e7c459973e27ad5a0d7a116d37bdd3fbc37044f4 - commit 3 of 6             100%
EOF
