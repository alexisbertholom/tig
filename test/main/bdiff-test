#!/bin/sh
#
# Test the base diff of `tig --bdiff`.

. libtest.sh
. libgit.sh

export LINES=18

tigrc <<EOF
set line-graphics = ascii
set main-view = id:no date:no author:no commit-title:yes,graph,refs,overflow=no
set diff-view = line-number:no text
EOF

steps '
	:save-display bdiff-main.screen

	:2
	:enter
	:save-display bdiff-del.screen
	:view-close

	:4
	:enter
	:save-display bdiff-change.screen
	:view-close

	:5
	:enter
	:save-display bdiff-move.screen
'

setup_bdiff_repo()
{
	rewrite_date="Sat Apr 4 13:29:36 2015 +0200"

	git_init .

	git_add base "base"
	git_commit -m "Base"

	git_add b "b"
	git_commit -m "Kept commit"

	git_add c "c"
	git_commit -m "Changed commit"

	git_add d "d"
	git_commit -m "Moved commit"

	git_add e "e"
	git_commit -m "Removed commit"

	git branch old

	# Rewrite the history: the moved commit now comes first, the changed
	# commit gains a line, the removed commit is dropped and a new commit
	# is added on top.  Cherry-picking keeps the author dates, the way a
	# rebase would.
	git reset -q --hard old~3
	unset GIT_AUTHOR_DATE
	GIT_COMMITTER_DATE="$rewrite_date" git cherry-pick old~1 >/dev/null
	GIT_COMMITTER_DATE="$rewrite_date" git cherry-pick old~2 >/dev/null
	file c "c and more"
	git add c
	GIT_COMMITTER_DATE="$rewrite_date" git commit -q --amend --no-edit

	git_add f "f"
	git_commit -m "Added commit"
}

in_work_dir setup_bdiff_repo

test_tig --bdiff old

assert_equals 'bdiff-main.screen' <<EOF
* [master] [add] Added commit
* [old] [del] Removed commit
* [from #1] Moved commit
* [change] Changed commit
* [move #1] Moved commit
* Kept commit
I Base
 
 
 
 
 
 
 
 
 
[main] 4e46f100f709900c927ed2df103aa44316df294d - commit 1 of 5             100%
EOF

assert_equals 'bdiff-del.screen' <<EOF
* [master] [add] Added commit           |[del] previous commit 4e9f6b1d68331c9eb
* [old] [del] Removed commit            |commit 4e9f6b1d68331c9eb3b3269e0c75893e
* [from #1] Moved commit                |Refs: [old]
* [change] Changed commit               |Author:     Committer <c.ommitter@examp
* [move #1] Moved commit                |AuthorDate: Fri Mar 20 01:00:10 2009 +0
* Kept commit                           |Commit:     Committer <c.ommitter@examp
I Base                                  |CommitDate: Fri Mar 20 01:00:10 2009 +0
                                        |
                                        |    Removed commit
                                        |---
                                        | e | 1 +
                                        | 1 file changed, 1 insertion(+)
                                        |
                                        |diff --git a/e b/e
                                        |new file mode 100644
                                        |index 0000000..9cbe6ea
[main] 4e9f6b1d68331c9eb3b3269e0c75 100%|[diff] 4e9f6b1d68331c9eb3b3269e0c75 76%
EOF

assert_equals 'bdiff-change.screen' <<EOF
