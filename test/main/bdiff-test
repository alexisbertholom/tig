* [old] [del] Removed commit            |-Parents:    35377cf90335d8d9b5a10fa56d
* [from #1] Moved commit                |+Parents:    2563dc225b06362b3460264b30
* [change] Changed commit               |
* [move #1] Moved commit                |[change] range diff
* Kept commit                           |    @@ Commit message
I Base                                  |
                                        |      ## c (new) ##
                                        |     @@
                                        |    -+c
                                        |    ++c and more
                                        |      \ No newline at end of file
                                        |
                                        |[change] commit a6f8f7c1d96242272b02ca8
                                        |commit a6f8f7c1d96242272b02ca872f7fb56d
                                        |Author:     Committer <c.ommitter@examp
[main] a6f8f7c1d96242272b02ca872f7f 100%|[diff] a6f8f7c1d96242272b02ca872f7f 29%
EOF

assert_equals 'bdiff-move.screen' <<EOF
* [master] [add] Added commit           |[move #1] metadata
* [old] [del] Removed commit            |-Parents:    0378086e895fbc999219b22f45
* [from #1] Moved commit                |+Parents:    35377cf90335d8d9b5a10fa56d
* [change] Changed commit               |-Position:   2
* [move #1] Moved commit                |+Position:   1
* Kept commit                           |
I Base                                  |[move #1] commit 2563dc225b06362b346026
                                        |commit 2563dc225b06362b3460264b3008ec22
                                        |Author:     Committer <c.ommitter@examp
                                        |AuthorDate: Wed Mar 11 12:38:00 2009 +0
                                        |Commit:     Committer <c.ommitter@examp
                                        |CommitDate: Sat Apr 4 13:29:36 2015 +02
